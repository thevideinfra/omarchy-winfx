{
  "schemaVersion": 1,
  "id": "videinfra.omarchy-winfx",
  "name": "WinFX",
  "version": "0.5.0",
  "author": "thevideinfra",
  "license": "MIT",
  "description": "Theme-native window open and close effects for Omarchy: ten effects including shatter, explode, matrix and glitch",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "WinFX",
    "description": "Choose and preview window open and close effects",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "density": "normal",
      "fontSize": "normal",
      "accent": "theme",
      "showAccent": true,
      "showHeaderInfo": true,
      "dimWhenOff": true,
      "rightClickToggle": false,
      "showStatus": true,
      "showHints": true
    },
    "schema": [
      {
        "key": "density",
        "type": "enum",
        "label": "Density",
        "options": [
          "compact",
          "normal",
          "roomy"
        ],
        "defaultValue": "normal",
        "description": "How tightly the panel is laid out."
      },
      {
        "key": "fontSize",
        "type": "enum",
        "label": "Font size",
        "options": [
          "small",
          "normal",
          "large"
        ],
        "defaultValue": "normal",
        "description": "Text size, on top of the density's own scaling."
      },
      {
        "key": "accent",
        "type": "enum",
        "label": "Accent colour",
        "options": [
          "theme",
          "blue",
          "cyan",
          "green",
          "magenta",
          "yellow",
          "red",
          "orange"
        ],
        "defaultValue": "theme",
        "description": "The colour the panel highlights with: the theme's accent, or a colour from its palette."
      },
      {
        "key": "showAccent",
        "type": "boolean",
        "label": "Accent colours",
        "defaultValue": true
      },
      {
        "key": "showHeaderInfo",
        "type": "boolean",
        "label": "Show the version and GitHub link in the header",
        "defaultValue": true
      },
      {
        "key": "dimWhenOff",
        "type": "boolean",
        "label": "Dim the bar icon while effects are off",
        "defaultValue": true
      },
      {
        "key": "rightClickToggle",
        "type": "boolean",
        "label": "Right-click the bar icon to switch effects on or off",
        "defaultValue": false
      },
      {
        "key": "showStatus",
        "type": "boolean",
        "label": "Show the backend status line",
        "defaultValue": true
      },
      {
        "key": "showHints",
        "type": "boolean",
        "label": "Show the key hints",
        "defaultValue": true
      }
    ]
  }
}
